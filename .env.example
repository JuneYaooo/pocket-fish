# The local API listens on loopback; place an HTTPS reverse proxy in front when deploying.
FISH_PORT=8787
FISH_DB=.data/pocket-fish.sqlite
# Absolute HTTPS API origin for a WeChat build. H5 uses its same-origin /api proxy by default.
VITE_API_BASE_URL=
# Match src/manifest.json mp-weixin.appid. The secret stays on the server.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Optional OpenAI-compatible chat-completions endpoint. Keep credentials server-side.
FISH_RECOGNITION_URL=
FISH_RECOGNITION_KEY=
FISH_RECOGNITION_MODEL=
